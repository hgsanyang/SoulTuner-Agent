# One dropdown value controls the Planner used by the demo.
# qwen3.7-plus | soultuner-v4.2-35b | safe
SOULTUNER_MODEL_PROFILE=qwen3.7-plus

# Current laptop / CPU Space profile. Store the real value as a Secret.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOULTUNER_QWEN_MODEL=qwen3.7-plus

# AMD Creation Space / remote 35B profile.
SOULTUNER_PLANNER_ENDPOINT=
SOULTUNER_PLANNER_MODEL=soultuner-planner-v4.2-35b
SOULTUNER_PLANNER_PROTOCOL=openai
SOULTUNER_PLANNER_TOKEN=
SOULTUNER_PLANNER_TIMEOUT=30
